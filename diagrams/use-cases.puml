@startuml use-cases
skinparam monochrome false
skinparam backgroundColor #FEFEFE

title Casos de Uso — SmartDiningRoom (SmartComedor)

left to right direction

actor Estudiante as Est
actor Supervisor as Sup
actor Administrador as Admin
actor "Auditor\nExterno" as Aud
actor "Sistema\n(Cron)" as Sys

rectangle "SmartComedor" {

  ' ── Autenticación ──
  package "Autenticación" {
    (Registrarse\ncon SISBEN) as UC1
    (Iniciar Sesión) as UC2
    (Recuperar Contraseña) as UC3
    (Configurar 2FA) as UC4
    (Verificar 2FA) as UC5
    (Unirse como\nSupervisor) as UC6
  }

  ' ── Estudiantes ──
  package "Gestión de Estudiantes" {
    (Ver Perfil y\nAlmuerzos) as UC7
    (Ver/Subir Pago) as UC8
    (Calificar Servicio) as UC9
    (Enviar Queja/\nSugerencia) as UC10
    (Ver Noticias) as UC11
  }

  ' ── Supervisor ──
  package "Operación del Comedor" {
    (Buscar Estudiante) as UC12
    (Registrar Almuerzo) as UC13
    (Ver Historial de\nAsistencias) as UC14
  }

  ' ── Admin ──
  package "Administración" {
    (Gestionar\nEstudiantes) as UC15
    (Importar desde\nExcel) as UC16
    (Gestionar\nSupervisores) as UC17
    (Asignar Estudiantes\na Supervisor) as UC18
    (Generar Link\nde Invitación) as UC19
    (Verificar Pagos) as UC20
    (Validar SISBEN) as UC21
    (Gestionar Ciclos) as UC22
    (Gestionar Noticias) as UC23
    (Responder Quejas) as UC24
    (Ver Dashboard\ny Reportes) as UC25
  }

  ' ── Auditoría ──
  package "Auditoría" {
    (Ver Logs\nde Auditoría) as UC26
    (Ver Panel\nde Actividad) as UC27
  }

  ' ── Automatización ──
  package "Automatización" {
    (Cerrar Ciclos\nExpirados) as UC28
    (Deshabilitar\nEstudiantes) as UC29
    (Enviar Emails de\nRevalidación) as UC30
    (Backup Diario\nde BD) as UC31
  }
}

' ── Relaciones Actor → Casos de Uso ──

Est --> UC1
Est --> UC2
Est --> UC3
Est --> UC4
Est --> UC5
Est --> UC7
Est --> UC8
Est --> UC9
Est --> UC10
Est --> UC11

Sup --> UC2
Sup --> UC6
Sup --> UC12
Sup --> UC13
Sup --> UC14

Admin --> UC2
Admin --> UC15
Admin --> UC16
Admin --> UC17
Admin --> UC18
Admin --> UC19
Admin --> UC20
Admin --> UC21
Admin --> UC22
Admin --> UC23
Admin --> UC24
Admin --> UC25

Aud --> UC2
Aud --> UC26
Aud --> UC27

Sys --> UC28
Sys --> UC29
Sys --> UC30
Sys --> UC31

' ── Relaciones entre Casos de Uso ──

UC8 ..> UC20 : <<extend>>\n(admin verifica)
UC21 ..> UC1 : <<extend>>\n(OCR automático)
UC13 ..> UC12 : <<include>>
UC28 ..> UC29 : <<include>>
UC28 ..> UC30 : <<include>>
UC6 ..> UC17 : <<extend>>\n(admin autoriza)

@enduml
