@startuml
title Diagrama Entidad-Relación - SmartComedor

skinparam {
  DatabaseBorderColor #2C3E50
  DatabaseBackgroundColor #ECF0F1
  DatabaseFontColor #2C3E50
  ArrowColor #3498DB
}

database "SmartComedor DB" {

  entity "users" {
    * **id** : UUID <<PK>>
    --
    * email : VARCHAR(30) <<UNIQUE>>
    * password : VARCHAR(255)
    * name : VARCHAR(20)
    * lastName : VARCHAR(20)
    * role : ENUM('admin','supervisor','student')
    * isActive : BOOLEAN
    * isAuthorized : BOOLEAN
    --
    resetPasswordToken : VARCHAR(255)
    resetPasswordExpires : TIMESTAMP
    createdAt : TIMESTAMP
    updatedAt : TIMESTAMP
  }

  entity "students" {
    * **id** : UUID <<PK>>
    --
    * userId : UUID <<FK>>
    * cedula : VARCHAR(12) <<UNIQUE>>
    * carrera : VARCHAR(25)
    * semestre : INTEGER
    * categoriaSisben : VARCHAR(10)
    * archivoSisben : VARCHAR(255)
    --
    direccion : VARCHAR(100)
    * barrio : VARCHAR(50)
    * telefono : VARCHAR(15)
    * trabaja : BOOLEAN
    * etnia : VARCHAR(30)
    * desplazado : BOOLEAN
    * trabajadorUniversitario : BOOLEAN
    * diasComedor : JSONB
    qrCode : TEXT
    qrCodeSecret : VARCHAR(255)
    * isValidatedSisben : BOOLEAN
    createdAt : TIMESTAMP
    updatedAt : TIMESTAMP
  }

  entity "payments" {
    * **id** : UUID <<PK>>
    --
    * studentId : UUID <<FK>>
    * amount : INTEGER
    * mealsIncluded : INTEGER
    * mealsUsed : INTEGER
    * comprobantePath : VARCHAR(255)
    * isVerified : BOOLEAN
    verifiedBy : UUID <<FK>>
    createdAt : TIMESTAMP
    updatedAt : TIMESTAMP
  }

  entity "meal_attendances" {
    * **id** : UUID <<PK>>
    --
    * studentId : UUID <<FK>>
    * supervisorId : UUID <<FK>>
    * date : DATE
    * hora : VARCHAR(10)
    createdAt : TIMESTAMP
    updatedAt : TIMESTAMP
  }

  entity "supervisor_logs" {
    * **id** : UUID <<PK>>
    --
    * supervisorId : UUID <<FK>>
    * studentId : UUID <<FK>>
    * action : VARCHAR(100)
    * hora : VARCHAR(10)
    createdAt : TIMESTAMP
    updatedAt : TIMESTAMP
  }

  entity "ratings" {
    * **id** : UUID <<PK>>
    --
    * studentId : UUID <<FK>>
    * stars : INTEGER
    comment : TEXT
    createdAt : TIMESTAMP
    updatedAt : TIMESTAMP
  }

  entity "complaints" {
    * **id** : UUID <<PK>>
    --
    studentId : UUID <<FK>>
    * type : ENUM('queja','sugerencia','comentario')
    * content : TEXT
    * isAnonymous : BOOLEAN
    response : TEXT
    respondedBy : UUID <<FK>>
    * isResolved : BOOLEAN
    createdAt : TIMESTAMP
    updatedAt : TIMESTAMP
  }

  entity "news" {
    * **id** : UUID <<PK>>
    --
    * title : VARCHAR(100)
    * content : TEXT
    imageUrl : VARCHAR(255)
    * isActive : BOOLEAN
    createdAt : TIMESTAMP
    updatedAt : TIMESTAMP
  }

  entity "audit_logs" {
    * **id** : UUID <<PK>>
    --
    * userId : UUID <<FK>>
    * userEmail : VARCHAR(100)
    * action : VARCHAR(100)
    details : TEXT
    ipAddress : VARCHAR(45)
    createdAt : TIMESTAMP
    updatedAt : TIMESTAMP
  }

  entity "supervisor_assignments" {
    * **id** : UUID <<PK>>
    --
    * supervisorId : UUID <<FK>>
    * studentId : UUID <<FK>>
    createdAt : TIMESTAMP
    updatedAt : TIMESTAMP
  }
}

' ========================================
' Relaciones
' ========================================
users ||--o{ students : "1 a 1"
users ||--o{ payments : "verifica 0..*"
users ||--o{ meal_attendances : "registra 0..*"
users ||--o{ supervisor_logs : "genera 0..*"
users ||--o{ audit_logs : "genera 0..*"
users ||--o{ complaints : "responde 0..*"

students ||--o{ payments : "tiene 0..*"
students ||--o{ meal_attendances : "asiste 0..*"
students ||--o{ ratings : "califica 0..*"
students ||--o{ complaints : "envía 0..*"

students ||--o{ supervisor_assignments : "asignado 0..*"
users ||--o{ supervisor_assignments : "supervisa 0..*"

@enduml
