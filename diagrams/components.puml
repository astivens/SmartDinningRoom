@startuml components
skinparam monochrome false
skinparam backgroundColor #FEFEFE
skinparam componentStyle rectangle

title Diagrama de Componentes — SmartDiningRoom (Arquitectura Full-Stack)

package "Cliente (React + Vite + MUI 5)" {
  [App Router] as AppRouter
  [AuthProvider] as AuthCtx
  [API Layer\n(axios)] as ClientAPI
  [Admin Pages] as AdminUI
  [Supervisor Pages] as SupUI
  [Student Pages] as StdUI
  [Auditor Page] as AudUI
}

package "Servidor (Express + TypeScript)" {
  package "Routes (/api)" {
    [authRoutes] as AuthR
    [studentRoutes] as StdR
    [cycleRoutes] as CycleR
    [paymentRoutes] as PayR
    [mealRoutes] as MealR
    [supervisorRoutes] as SupR
    [newsRoutes] as NewsR
    [ratingRoutes] as RatR
    [complaintRoutes] as CmpR
    [auditRoutes] as AudR
  }

  package "Middleware" {
    [authenticate] as AuthMW
    [authorize] as AuthzMW
    [optionalAuth] as OptMW
    [upload (multer)] as UpMW
    [auditHttpEvents] as AudMW
  }

  package "Controllers" {
    [AuthController] as AuthC
    [StudentsController] as StdC
    [CycleController] as CycleC
    [MealsController] as MealC
    [PaymentsController] as PayC
    [SupervisorsController] as SupC
    [NewsController] as NewsC
    [ComplaintsController] as CmpC
    [RatingsController] as RatC
  }

  package "Services" {
    [EmailService\n(Nodemailer)] as EmailS
    [AuditService] as AudS
    [SisbenValidationService\n(pdf-parse + Tesseract)] as SisS
    [CycleAutomationService\n(node-cron)] as CycS
    [BackupService\n(pg_dump + cron)] as BkpS
  }

  package "Models (Sequelize ORM)" {
    database "PostgreSQL" as DB {
      [users]
      [students]
      [cycles]
      [payments]
      [meal_attendances]
      [supervisor_assignments]
      [supervisor_logs]
      [ratings]
      [complaints]
      [news]
      [audit_logs]
    }
  }
}

' Conexiones cliente-servidor
AppRouter --> ClientAPI : HTTP
ClientAPI --> AuthR : /api/auth/*
ClientAPI --> StdR : /api/students/*
ClientAPI --> CycleR : /api/cycles/*
ClientAPI --> PayR : /api/payments/*
ClientAPI --> MealR : /api/meals/*
ClientAPI --> SupR : /api/supervisors/*
ClientAPI --> NewsR : /api/news/*
ClientAPI --> RatR : /api/ratings/*
ClientAPI --> CmpR : /api/complaints/*
ClientAPI --> AudR : /api/audit/*

' Routes -> Controllers
AuthR --> AuthC
StdR --> StdC
CycleR --> CycleC
PayR --> PayC
MealR --> MealC
SupR --> SupC
NewsR --> NewsC
RatR --> RatC
CmpR --> CmpC
AudR --> AudC : (sin controller, usa modelo directo)

' Middleware
AuthR --> AuthMW
AuthR --> UpMW
AuthR --> AudMW

' Controllers -> Services
AuthC --> EmailS
AuthC --> AudS
AuthC --> SisS
StdC --> AudS
StdC --> SisS
PayC --> AudS
MealC --> EmailS
MealC --> AudS
SupC --> AudS

' Services -> Models
AudS --> DB
EmailS --> DB
SisS --> DB
CycS --> DB
BkpS --> DB

' Schedulers
CycS -[hidden]-> BkpS
note right of CycS
  Cron: diario 01:00
  Cierra ciclos expirados
  Deshabilita estudiantes
  Envía emails de revalidación
end note

note right of BkpS
  Cron: diario 02:00
  pg_dump + gzip
  Retención 30 días
end note

@enduml
