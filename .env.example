# ── Server ────────────────────────────────────────────────────────────────────
PORT=3002
NODE_ENV=production

# ── Database ───────────────────────────────────────────────────────────────────
DB_PORT=5433
DB_NAME=smart_comedor
DB_USER=postgres
DB_PASSWORD=postgres
# DB_HOST is set automatically to "postgres" inside Docker

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_super_secret_key
JWT_REFRESH_SECRET=change_me_refresh_secret_key
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Email (SMTP) ────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SmartComedor <noreply@smartcomedor.com>

# ── Frontend URL ───────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost
