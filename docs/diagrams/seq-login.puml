@startuml seq-login
skinparam monochrome false
skinparam backgroundColor #FEFEFE
skinparam ParticipantPadding 20
skinparam BoxPadding 10

title Login de Usuario (con validación de rol y generación de JWT)

actor Cliente
participant ":AuthController" as AC
participant ":User (Model)" as UM
participant ":Student (Model)" as SM
participant ":AuditService" as AS
participant ":AuditLog (Model)" as AL

Cliente -> AC: POST /api/auth/login\n{ email, password, role }

alt Campos faltantes
    AC --> Cliente: 400 "Email, contraseña y rol son requeridos"
end

AC -> UM: findOne({ where: { email } })

alt Usuario no existe
    AC --> Cliente: 401 "Credenciales inválidas"
end

AC -> UM: validatePassword(password)

alt Contraseña incorrecta
    AC --> Cliente: 401 "Credenciales inválidas"
end

alt Usuario inactivo
    AC --> Cliente: 401 "Usuario inactivo"
end

alt Rol no coincide
    AC --> Cliente: 403 "Usted no está autorizado"
end

alt Admin/Supervisor/Auditor no autorizado
    AC --> Cliente: 403 "Usted no está autorizado"
end

alt Rol STUDENT con 2FA habilitado
    AC -> SM: findOne({ where: { userId } })
    SM --> AC: student (qrCode, qrCodeSecret)

    alt Sin twoFactorToken
        AC --> Cliente: 200 { requiresTwoFactor, twoFactorToken }
        Cliente -> AC: POST /api/auth/login\n{ ..., twoFactorCode, twoFactorToken }
        AC -> AC: jwt.verify(twoFactorToken)
        AC -> AC: speakeasy.totp.verify(code, secret)

        alt Código 2FA inválido
            AC --> Cliente: 400 "Código 2FA inválido"
        end
    end
end

AC -> AC: generateTokens(user)\n→ { accessToken (15m), refreshToken (7d) }

AC -> AS: logAction(userId, email, 'LOGIN', details, req)
AS -> AL: create({ userId, userEmail, action, details, ipAddress })

AC --> Cliente: 200 { message, user, accessToken, refreshToken }

@enduml
