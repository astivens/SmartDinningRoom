@startuml seq-payment
skinparam monochrome false
skinparam backgroundColor #FEFEFE
skinparam ParticipantPadding 20
skinparam BoxPadding 10

title Creación y Validación de Pago por Administrador

actor Admin
participant ":PaymentsController" as PC
participant ":Student (Model)" as SM
participant ":User (Model)" as UM
participant ":Payment (Model)" as PM
participant ":FileSystem (fs)" as FS
participant ":AuditService" as AS

== Subir comprobante ==

Admin -> PC: POST /api/payments/upload\n{ studentId, amount } + files

alt No autenticado
    PC --> Admin: 401 "No autenticado"
end

alt Sin archivos
    PC --> Admin: 400 "Archivo requerido"
end

PC -> UM: findByPk(requesterId)

alt Requester es STUDENT
    PC -> SM: findOne({ userId: requesterId })
else Requester es ADMIN con studentId
    PC -> SM: findByPk(studentId)
end

alt Estudiante no encontrado
    PC --> Admin: 404 "Estudiante no encontrado"
end

PC -> PC: mealsIncluded = floor(amount / 2000)

PC -> PM: create({ studentId, amount, mealsIncluded,\nmealsUsed: 0, comprobantePath, ...,\nisVerified: false })
PM --> PC: payment

PC -> AS: logAction(id, email, 'UPLOAD_PAYMENT_RECEIPT', ...)

PC --> Admin: 201 { message, payment }

== Verificar pago ==

Admin -> PC: PUT /api/payments/:id/verify

PC -> PM: findByPk(id)

alt Pago no encontrado
    PC --> Admin: 404 "Pago no encontrado"
end

PC -> PM: update({ isVerified: true,\n  verifiedBy: adminId, verifiedAt: now })

loop Por cada path\n(comprobante, university, bank)
    alt Path no vacío
        PC -> FS: unlink(path)
        FS --> PC: ok o ENOENT ignorado
    end
end

PC -> PM: update({ comprobantePath: '',\n  universityReceiptPath: '',\n  bankReceiptPath: '' })

PC -> AS: logAction(id, email, 'VERIFY_PAYMENT', ...)

PC --> Admin: 200 { message: 'Pago verificado', payment }

@enduml
