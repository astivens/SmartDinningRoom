@startuml seq-meal
skinparam monochrome false
skinparam backgroundColor #FEFEFE
skinparam ParticipantPadding 20
skinparam BoxPadding 10

title Registro de Almuerzo por Supervisor

actor Supervisor
participant ":MealsController" as MC
participant ":Student (Model)" as SM
participant ":User (Model)" as UM
participant ":MealAttendance (Model)" as MA
participant ":Payment (Model)" as PM
participant ":SupervisorLog (Model)" as SL
participant ":EmailService" as ES
participant ":AuditService" as AS

Supervisor -> MC: POST /api/meals/register\n{ studentId }

alt No autenticado
    MC --> Supervisor: 401 "No autenticado"
end

MC -> SM: findByPk(studentId)

alt Estudiante no encontrado
    MC --> Supervisor: 404 "Estudiante no encontrado"
end

MC -> UM: findByPk(student.userId)

alt Usuario inactivo
    MC --> Supervisor: 400 "Estudiante inactivo"
end

MC -> MC: Obtener dia actual en espanol\n(Lunes..Viernes)

alt Dia no autorizado
    MC --> Supervisor: 400 "No tiene autorizacion"
end

MC -> MA: findOne({ studentId, date: today })

alt Ya asistio hoy
    MC --> Supervisor: 400 "Ya uso el comedor hoy"
end

MC -> PM: findAll({ studentId, isVerified: true })
PM --> MC: payments[]

MC -> MC: total = sum(mealsIncluded)\nused = sum(mealsUsed)\navailable = total - used

alt Sin almuerzos disponibles
    MC --> Supervisor: 400 "No tiene almuerzos"
end

MC -> MA: create({ studentId, supervisorId, date, hora })
MA --> MC: attendance

MC -> PM: latestPayment.update({ mealsUsed: +1 })

MC -> SL: create({ supervisorId, studentId,\n  action: 'Registro de almuerzo', hora })

MC -> ES: sendMealConfirmation(user, student, date)
ES --> MC: (async)

MC -> AS: logAction(id, email, 'REGISTER_MEAL', ...)

MC --> Supervisor: 200 { message, attendance, mealsRemaining }

@enduml
